# Supabase Cloud Database Credentials
# Replace the placeholder values below with your actual keys from your Supabase Dashboard:
# Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Secret Admin Panel Password Protection (Route: /tbb)
NEXT_PUBLIC_ADMIN_PASSWORD=your-secure-admin-password-here
